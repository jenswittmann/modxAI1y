{
    "name": "modxAI1y",
    "lowCaseName": "modxai1y",
    "description": "modxAI1y creates alt texts for images in ContentBlocks with Claude.",
    "author": "Jens Wittmann",
    "version": "0.2.0-beta",
    "package": {
        "elements": {
            "plugins": [
                {
                    "name": "modxai1y",
                    "events": ["OnManagerPageBeforeRender"]
                }
            ]
        },
        "systemSettings": [
            { "key": "apikey", "type": "text-password", "area": "default", "value": "" },
            { "key": "model", "type": "textfield", "area": "default", "value": "claude-haiku-5-5" },
            { "key": "prompt", "type": "textarea", "area": "default", "value": "" },
            { "key": "language", "type": "textfield", "area": "default", "value": "Deutsch" },
            { "key": "max_length", "type": "numberfield", "area": "default", "value": "125" },
            { "key": "max_image_edge", "type": "numberfield", "area": "default", "value": "1568" },
            { "key": "allowed_paths", "type": "textfield", "area": "default", "value": "upload/" },
            { "key": "field_queries", "type": "textarea", "area": "default", "value": "" },
            { "key": "api_base_url", "type": "textfield", "area": "default", "value": "" }
        ]
    },
    "dependencies": [
        {
            "name": "php",
            "version": ">=8.1"
        },
        {
            "name": "modx",
            "version": ">=3.0"
        }
    ],
    "build": {
        "readme": "docs/readme.md",
        "license": "docs/license.md",
        "changelog": "docs/changelog.md"
    }
}
