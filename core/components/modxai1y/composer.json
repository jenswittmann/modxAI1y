{
    "name": "jenswittmann/modxai1y",
    "description": "modxAI1y creates alt texts for images in ContentBlocks with Claude.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^1.6",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "Modxai1y\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    }
}
